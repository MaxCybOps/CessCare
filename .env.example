# Postgres connection string for the waitlist table.
# Free options: Neon (neon.tech) or Supabase (supabase.com) — create a project,
# then copy the connection string. Pooled connection recommended for serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Optional. Salts the hashed IP stored against each signup for abuse triage.
# Any random string; set it once and don't change it.
IP_HASH_SALT=""
