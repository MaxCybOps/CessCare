# ─── Supabase Postgres ────────────────────────────────────────────────────────
# Supabase → your project → Connect (top bar) → ORMs → Prisma.
# You need BOTH URLs. They are different and not interchangeable.

# 1. Pooled connection — used by the running app.
#    Transaction pooler, port 6543. Handles many short-lived serverless requests.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct connection — used by the Prisma CLI (db push, studio, migrate).
#    Port 5432. Schema changes cannot run through the transaction pooler.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── Optional ─────────────────────────────────────────────────────────────────
# Salts the hashed IP stored against each signup for abuse triage.
# Any random string. Set it once and don't change it.
IP_HASH_SALT=""
